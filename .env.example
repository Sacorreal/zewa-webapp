# Copiar a .env.local (desarrollo). En Railway/Vercel, definirlas en las variables del servicio.

# URL base de zewa-api usada desde el servidor de Next.js (Server Actions). Privada.
API_URL=http://localhost:3001

# URL base de zewa-api usada desde el navegador. Se incrusta en el bundle durante `next build`.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Ambas son el ORIGEN del API (sin /api/v1): el cliente HTTP añade el prefijo de versión.
# Para correr ambos proyectos a la vez, el API va en otro puerto (PORT=3001 en zewa-api).
